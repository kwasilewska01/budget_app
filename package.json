{
  "name": "moj-budzet-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "build:android:apk": "npx eas-cli@latest build --platform android --profile preview",
    "build:ios:device": "npx eas-cli@latest build --platform ios --profile preview",
    "build:ios:simulator": "npx eas-cli@latest build --platform ios --profile simulator",
    "build:all": "npx eas-cli@latest build --platform all --profile preview",
    "build:production": "npx eas-cli@latest build --platform all --profile production",
    "doctor": "expo-doctor",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "expo": "^58.0.25",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "expo-doctor": "^1.0.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  }
}
