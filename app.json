{
  "expo": {
    "name": "Mój budżet",
    "slug": "moj-budzet",
    "scheme": "mojbudzet",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "pl.mojbudzet.dev",
      "buildNumber": "1",
      "supportsTablet": true,
      "appleTeamId": "WLM8K5H7Z2"
    },
    "android": {
      "package": "pl.mojbudzet.mobile",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#182b3b",
          "enableRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png"
  }
}
